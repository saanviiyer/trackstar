# Base URL of the deejai backend used by Producer mode's AI features.
# Leave unset to use the built-in dev proxy at "/deejai" (see vite.config.ts),
# which forwards to http://localhost:8000 and avoids CORS in dev.
#
# Set this to point at a backend on another origin, for example:
# VITE_DEEJAI_URL=http://localhost:8000
# VITE_DEEJAI_URL=https://my-deejai-host.example.com
